{
  "deno.enable": true,
  "deno.lint": true,
  "editor.defaultFormatter": "denoland.vscode-deno",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.ts": "always",
    "source.organizeImports": "always"
  },
  "css.customData": [
    ".vscode/tailwind.json"
  ],
  "cSpell.words": [
    "asynciterable",
    "cursorrules",
    "dcterms",
    "dotenv",
    "foaf",
    "fontobject",
    "hintrc",
    "mstile",
    "msword",
    "noopen",
    "nosniff",
    "nums",
    "officedocument",
    "openxmlformats",
    "presentationml",
    "rdfa",
    "rdfs",
    "spreadsheetml",
    "supabase",
    "takker",
    "wordprocessingml"
  ]
}
