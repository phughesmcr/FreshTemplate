{
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "exclude": ["**/_fresh/*", "**/node_modules/*"],
  "fmt": { "lineWidth": 120 },
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "$std/": "https://deno.land/std@0.224.0/",
    "@openai/openai": "jsr:@openai/openai@^4.96.0",
    "@pakornv/fresh-plugin-tailwindcss": "jsr:@pakornv/fresh-plugin-tailwindcss@^1.0.2",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/http": "jsr:@std/http@^1.0.15",
    "@std/path": "jsr:@std/path@^1.0.9",
    "@takker/md5": "jsr:@takker/md5@^0.1.0",
    "brotli": "https://deno.land/x/brotli@0.1.7/mod.ts",
    "components/": "./components/",
    "compress": "https://deno.land/x/compress@v0.5.5/mod.ts",
    "fresh-session": "https://deno.land/x/fresh_session@0.2.4/mod.ts",
    "hooks/": "./hooks/",
    "islands/": "./islands/",
    "lib/": "./lib/",
    "preact": "https://esm.sh/preact@10.22.0",
    "routes/": "./routes/",
    "tailwindcss": "npm:tailwindcss@^4.1.4",
    "tailwindcss/": "npm:/tailwindcss@3.4.14/",
    "tailwindcss/plugin": "npm:/tailwindcss@3.4.14/plugin.js",
    "zod": "https://deno.land/x/zod@v3.24.2/mod.ts",
    "preact-render-to-string": "https://esm.sh/*preact-render-to-string@6.2.1",
    "preact/": "https://esm.sh/preact@10.22.0/"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "lock": true,
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno run -A dev.ts build",
    "check": "deno fmt && deno lint && deno check dev.ts && deno check main.ts",
    "cli": "echo \"import '\\$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
    "manifest": "deno task cli manifest $(pwd)",
    "preview": "deno run -A main.ts",
    "start": "deno run -A --watch=static/,routes/ dev.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update ."
  },
  "unstable": ["kv"]
}
